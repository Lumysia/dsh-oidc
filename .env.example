# TEMPLATE for a restricted service-manager EnvironmentFile (process env).
# Do NOT copy to $DSH_HOME/.env or a checkout .env: DSH rejects
# DSH_* bootstrap variables from .env layers. Keep real values outside Git.
DSH_OIDC_ISSUER=https://identity.example/application/o/dsh/
DSH_OIDC_CLIENT_ID=replace-with-client-id
DSH_OIDC_CLIENT_SECRET_REF=DSH_OIDC_CLIENT_SECRET
DSH_OIDC_PUBLIC_ORIGIN=https://dsh.example
DSH_OIDC_ALLOWED_SUBJECTS='[{"issuer":"https://identity.example/application/o/dsh/","subject":"replace-with-subject"}]'
# Only when Caddy reaches DSH from another container; default is loopback only.
# DSH_OIDC_TRUSTED_PROXIES='["172.18.0.0/16"]'

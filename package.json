{
  "name": "@lumysia/dsh-oidc",
  "version": "0.3.0-alpha.1",
  "description": "Provider-neutral OpenID Connect admission for DeepSeek Harness Web",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lumysia/dsh-oidc.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "dist",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    ".env.example",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:acceptance": "node scripts/integration-harness.mjs",
    "check:release": "npm run check && npm audit --audit-level=low && npm run test:acceptance",
    "pack:check": "node scripts/check-pack.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run pack:check && npm run secret:scan"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "openid-client": "^6.8.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.9.0",
    "@types/react": "^18.3.31",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "jose": "^6.2.2",
    "playwright": "^1.56.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "minimatch": "^11.0.1",
    "zod": "^4.6.6"
  },
  "homepage": "https://github.com/Lumysia/dsh-oidc#readme",
  "bugs": {
    "url": "https://github.com/Lumysia/dsh-oidc/issues"
  },
  "contributors": [
    "Senti100 (original author)",
    "Livia Zhang"
  ],
  "icon": "./icon.svg"
}
